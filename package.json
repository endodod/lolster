{
  "name": "lolster",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,party \"vite\" \"wrangler dev --port 1999\"",
    "dev:web": "vite",
    "dev:party": "wrangler dev --port 1999",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:party": "wrangler deploy"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@preact/preset-vite": "^2.10.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "wrangler": "^4.168.0"
  }
}